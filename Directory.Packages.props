<Project>
  <!--
    Central Package Management: every NuGet version lives HERE, once.
    .csproj files keep <PackageReference Include="..." /> WITHOUT a Version.
    Visual Studio's NuGet UI writes new versions into this file automatically.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!--
      STEP 6 of sub-chunk 6.2: move the versions the xUnit template generated
      into this list, keeping the exact numbers from your .csproj, e.g.

      <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="(your version)" />
      <PackageVersion Include="xunit" Version="(your version)" />
      <PackageVersion Include="xunit.runner.visualstudio" Version="(your version)" />
      <PackageVersion Include="coverlet.collector" Version="(your version)" />
    -->
  </ItemGroup>
</Project>